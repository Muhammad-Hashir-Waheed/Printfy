{
   "compilerOptions": {
      "target": "ESNext",
      "lib": ["dom", "dom.iterable", "esnext"],
      "allowJs": true,
      "skipLibCheck": true,
      "strict": false,
      "forceConsistentCasingInFileNames": true,
      "noEmit": true,
      "esModuleInterop": true,
      "module": "esnext",
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "isolatedModules": true,
      "jsx": "preserve",
      "incremental": true,
      "plugins": [
         {
            "name": "next"
         }
      ],
      "paths": {
         "@/*": ["./src/*"],
         "@domain-pricing": ["../../packages/domain-pricing/src/index.ts"],
         "@domain-orders": ["../../packages/domain-orders/src/index.ts"],
         "@domain-checkout": ["../../packages/domain-checkout/src/index.ts"],
         "@domain-fulfillment": ["../../packages/domain-fulfillment/src/index.ts"]
      },
      "strictNullChecks": false
   },
   "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
   "exclude": ["node_modules"]
}
