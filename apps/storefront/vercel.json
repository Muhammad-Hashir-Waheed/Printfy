{
   "$schema": "https://openapi.vercel.sh/vercel.json",
   "framework": "nextjs",
   "cleanUrls": true,
   "installCommand": "cd ../.. && npm ci && npm ci --prefix apps/storefront",
   "buildCommand": "npm run vercel-build",
   "outputDirectory": ".next",
   "headers": [
      {
         "source": "/fonts/Inter/Inter.woff2",
         "headers": [
            {
               "key": "Cache-Control",
               "value": "public, max-age=31536000, immutable"
            }
         ]
      },
      {
         "source": "/fonts/Yekan/Yekan.woff",
         "headers": [
            {
               "key": "Cache-Control",
               "value": "public, max-age=31536000, immutable"
            }
         ]
      }
   ],
   "redirects": []
}
