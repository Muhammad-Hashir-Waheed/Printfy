# Cloudflare static-asset headers (files served straight from the edge, without the Worker).
# Pages and API responses get theirs from next.config.js.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Fingerprinted build files never change
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Product photos and their pre-sized copies: a month, refreshed in the background after that
/_v/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/catalog/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/packaging/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
