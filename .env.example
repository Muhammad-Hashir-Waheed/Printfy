DATABASE_URL=""
DIRECT_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_URL="http://localhost:7777"
JWT_SECRET_KEY=""

# Catalog photos (free key from https://pixabay.com/api/docs/). Used only by `npm run images:fetch`.
PIXABAY_API_KEY=

# Design Studio admin (/admin) — required
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Design file storage — required in production (Vercel). Locally files go to ./.data
# Supabase → Project Settings → API. Keep the service role key secret (server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DESIGNS_BUCKET=joji-designs

# Customer accounts (database mode) — off by default
# ENABLE_ACCOUNTS=true

# Email (customer tracking links + team alerts). Pick ONE provider:
# Resend (recommended): https://resend.com → API Keys. Verify your domain to send from it.
RESEND_API_KEY=
# …or any SMTP server (Gmail app password, Zoho, Outlook, your host):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
EMAIL_FROM="Joji Arts <studio@jojiarts.com>"
EMAIL_REPLY_TO=support@jojiarts.com
# Where new-design alerts go (defaults to orders@jojiarts.com)
STUDIO_NOTIFY_EMAIL=
